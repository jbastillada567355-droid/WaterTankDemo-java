package watertank;

class Watertank {
	public static void main(String[] args) {
		private String name;
		private int[] buckets;
		private int top;
		
		public watertank() {
			this.name = "Standad Tank";
			this.buckets = new int[5];
			this.top = -1;
			System.out.println(name + "created no-arg constructor");
		}
		public watertank(String name, int capacity) {
			this.name = name;
			this.buckets = new int[capcity];
			this.top = -1;
			System.out.println(name + ": holds" + capacity + " buckets.");
		}
		
		public void pour(int liters) {
			if (top==buckets.length - 1) {
				System.out.println("OVERFLOW! " + name + "is full. " + leters + "L spilled");
				return;
			}
			top++;
			buckets[top] = litters;
			System.out.println("Poured" + litters + "L into " + name);
		}
		
		public int drain() {
			if(isEmpty()) {
				System.out.println("UNDERFLOW!");
				return 0;
			}
			int littters = buckets[top];
			top--;
			System.out.println("Drained" + litters + "L into " + name);
			return litters
		}
		
		public int checkTop() {
			if (isEmpty()) {
				System.out.println(name + " is empty.");
				return 0;
			}
			return buckets [top];
		}
		
		public boolean isEmpty() {
			return top == -1;
		}
		
		public int bucketCount() {
			return top + 1;
		}
		
		public int totallLiters() {
			int total = 0;
			for (int i = 0; i <= top; i++) {
				total += buckets[i];
			}
			return total;
		}
	}
}

public class WaterTankDemo{
	public static void main(String[] args) {
		//No-argument constructor
		WaterTank tank1 = new WaterTank();
		tank1.pour(10);
		tank1.pour(20);
		tank1.pour(15);
		System.out.println("Top bucket: " + tank1.checkTop() + "L");
		tank1.drain();
		System.out.println("Buckets left: " + tank1.bucketsCount() + " | Total water: " + tank1.bucketCount());
		
		//Parameterized Constructor
		WaterTank tank2 = new WaterTank("Mini Tank", 3);
		tank2.pour(5);
		tank2.pour(10);
		tank2.pour(15);
		tank2.pour(20);
		tank2.drain;
		tank2.drain;
		tank2.drain;
		tank2.drain;
		System.out.println("Is the tank empty? " + WaterTank.isEmpty());
	}
}
